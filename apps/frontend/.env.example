# Environment Configuration for Trace-X Frontend
# Copy this file to .env and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# AI/ML API Keys
# Get OpenRouter key from: https://openrouter.ai/
VITE_OPEN_ROUTER_API_KEY=your_openrouter_key_here

# Get Gemini key from: https://makersuite.google.com/app/apikey  
GEMINI_API_KEY=your_gemini_key_here

# Script API Endpoint
VITE_SCRIPT_API_ENDPOINT=https://openrouter.ai/api/v1
