# Desktop Application Environment Configuration
# This file is used when running as a Tauri desktop app

# INSTRUCTIONS:
# 1. Copy this file to .env.desktop
# 2. Fill in your actual API keys
# 3. Never commit .env.desktop to git

# API Configuration - Point to your backend server
VITE_API_URL=http://127.0.0.1:8000/api/v1

# AI/ML Services
# Get your key from: https://openrouter.ai/
VITE_OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
VITE_SCRIPT_API_ENDPOINT=https://openrouter.ai/api/v1

# Gemini API (if needed)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
